---
import { getLangFromUrl, useTranslations } from "../i18n/utils";
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const items = t("interviews.items");

const images = import.meta.glob<{ default: ImageMetadata }>('/src/assets/rozhovory/*');

items.map((item) => {
  if (!images[item.image]) {
    throw new Error(`Image ${item.image} not found`);
  }
})
---

<section id="rozhovory" class="pt-20 md:pr-60 px-4">
  <h2 class="text-gray-500 font-medium mb-4 text-xl">{t("interviews.title")}</h2>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
    {
      items.map((item) => (
        <div class="mb-6">
          <a
            href={item.link}
            target="_blank"
            class="w-full flex justify-center"
          >
            <div class="relative w-full">
              <Image
                src={images[item.image]()}
                class="rounded-md h-68 w-full object-cover"
                alt={item.title}
              />
            </div>
          </a>
          <p class="text-gray-500 text-sm pt-2">
            {item.title}
          </p>
          <p class="text-gray-400 text-xs">
            {item.source}
          </p>
        </div>
      ))
    }
  </div>
</section>
