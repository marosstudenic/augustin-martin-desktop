---
import { getLangFromUrl, useTranslations } from "../i18n/utils";
import { NewsItem } from "../i18n/data/news";

import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";

const images = import.meta.glob<{ default: ImageMetadata }>(
    "/src/assets/novinky/*",
);

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

(t("news.items") as NewsItem[]).map((karticka) => {
    const imgs = Array.isArray(karticka.image) ? karticka.image : [karticka.image];
    imgs.forEach((img) => {
        if (!images[img])
            throw new Error(
                `"${img}" does not exist in glob: '/src/assets/novinky/*'`,
            );
    });
});
---

<style>
    .nav-dots .nav-dot {
        font-size: 11px;
        margin: 0 4px;
        text-align: center;
        top: 5px;
        position: relative;
        transform: translateY(-50%);
        border-radius: 100%;
        display: inline-block;
        transition: all 0.5s ease-in-out;
        color: rgba(0, 0, 0, 0.253);
    }

    .nav-dot.active {
        color: #000;
    }

    .nav-dots .nav-dot:hover {
        cursor: pointer;
        color: rgba(0, 0, 0, 0.8);
    }
</style>

<section id="novinky" class="pt-20">
    <!--DESKTOP -->
    <div class="py-10 h-full md:block px-4">
        <h3 class="text-gray-500 mb-2 font-medium text-2xl">
            {t("news.title")}
        </h3>
        <div class="grid md:grid-cols-3 gap-8 md:max-w-6xl">
            {
                (t("news.items") as NewsItem[]).map((karticka) => {
                    const imgs = Array.isArray(karticka.image) ? karticka.image : [karticka.image];
                    return (
                    <div class:list={["rounded overflow-hidden shadow-lg flex justify-between flex-col", imgs.length > 1 && "md:col-span-2"]}>
                        <div class="">
                            <div class:list={[imgs.length > 1 && "md:flex md:flex-row"]}>
                                {imgs.map((img, i) => (
                                    <>
                                        {i > 0 && <div class="h-[2px] w-full md:hidden" style="background: linear-gradient(90deg, #996515, #d4a843, #f5d67b, #d4a843, #996515);" />}
                                        <Image
                                            class:list={["w-full object-cover", imgs.length > 1 && "md:flex-1 md:min-w-0"]}
                                            src={images[img]()}
                                            alt={karticka.title}
                                        />
                                    </>
                                ))}
                            </div>
                            <div class="px-6 py-4">
                                <div class="text-gray-500 text-lg font-semibold mb-2">
                                    {karticka.title}
                                </div>
                                <div class="flex flex-col gap-4">
                                    {karticka.text.map((item) => (
                                        <p class="text-gray-700 text-base">
                                            {item}
                                        </p>
                                    ))}
                                </div>
                            </div>
                        </div>

                        {karticka.link && (
                            <div class="px-6 pt-4 pb-2 mx-auto">
                                <a
                                    href={karticka.link}
                                    target="_blank"
                                    class="border border-black py-0.5 px-6 rounded-md"
                                    rel="nofollow noopener"
                                >
                                    <button class="btn">
                                        <span class="text-sm text-black">
                                            {t("utils.more")}
                                        </span>
                                    </button>
                                </a>
                            </div>
                        )}
                    </div>
                )})
            }
        </div>
    </div>
</section>
